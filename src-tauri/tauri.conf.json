{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mysdlcappversion",
  "version": "0.1.0",
  "identifier": "com.admin.mysdlcappversion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mysdlcappversion",
        "width": 800,
        "height": 600
      }
    ],
   
    "security": {
  "capabilities": ["default"]
}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
