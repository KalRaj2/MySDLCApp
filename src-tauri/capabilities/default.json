{
  "$schema": "../gen/schemas/desktop-schema.json",

  "identifier": "default",

  "description": "Default desktop permissions",

  "windows": ["main"],

  "permissions": [

    "core:default",

    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",

    "dialog:default",
    "dialog:allow-save",

    "fs:default",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-read-file",
    "fs:allow-mkdir",

    {
      "identifier": "fs:scope",

      "allow": [

        "$HOME/**",
        "$DOWNLOAD/**",
        "$DESKTOP/**",
        "$DOCUMENT/**"

      ]
    }

  ]
}